+        if (text.contains("补发")) return "补发";
+        if (text.matches("(?s).*(?:质量问题|商品破损|发错货|少件|与描述不符|收到.{0,8}(?:破了|坏了)).*")) return "质量问题售后";
+        return null;
+    }
