+def _policy_fallback_text(snippet: str, seen: set[str]) -> str:
+    """备用正文排除教学区，原始引用仍完整留给生成和评审。"""
+    lines = []
+    skip_examples = False
+    for line in snippet.splitlines():
+        heading = re.match(r"^#{1,6}\s+(.+)", line)
+        if heading:
+            skip_examples = bool(re.search(r"常见客服场景|常见客服问法|常见问法|常见客服对话|说明样例", heading[1]))
+            continue
+        if re.match(r"\s*(?:以下为模拟问法|以下问答为模拟场景)", line):
+            skip_examples = True
+        if skip_examples:
+            continue
+        line = re.sub(r"(?:详见|参见)\s*\[[^\]]+\]\([^)]+\)[。]?", "", line)
+        line = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", line)
+        kept = []
+        for sentence in re.split(r"(?<=[。！？])", line):
+            sentence = sentence.strip()
+            if not sentence or sentence.startswith(("本文是项目演示知识", "本轮文档更新时间")):
+                continue
+            key = re.sub(r"\s+", "", sentence)
+            if key not in seen:
+                seen.add(key)
+                kept.append(sentence)
+        if kept:
+            lines.append("".join(kept))
+    # shortcut: 只去除逐字重复，不用模糊相似度合并政策，以免丢失条件或否定；语义压缩另行验收。
+    return "\n".join(lines)
+
