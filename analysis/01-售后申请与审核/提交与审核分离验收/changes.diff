+        if httpx.get(backend + '/actuator/health', timeout=2).json().get('status') == 'UP':
+            break
+    except (httpx.HTTPError, ValueError):
+        pass
+    time.sleep(0.5)
+else:
+    raise RuntimeError('隔离后端未就绪')
